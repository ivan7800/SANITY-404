{
  "name": "sanity-404",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:web": "npm run build",
    "build:desktop:assets": "tsc --noEmit && vite build --mode desktop --outDir desktop/dist-desktop",
    "build:linux": "npm run build:desktop:assets && npm --prefix desktop run package:linux",
    "build:windows": "npm run build:desktop:assets && npm --prefix desktop run package:windows",
    "verify:distribution": "node scripts/verify-distribution.mjs",
    "verify:windows-package": "node scripts/verify-windows-package.mjs",
    "test:desktop:smoke": "node scripts/phase34-electron-smoke.mjs",
    "test:desktop:save": "node scripts/phase34-electron-save-smoke.mjs",
    "test:desktop:startup": "node scripts/phase35-electron-startup.mjs",
    "report:packages": "node scripts/phase34-package-report.mjs",
    "clean:artifacts": "node scripts/phase34-clean.mjs",
    "test": "vitest run",
    "audit:rooms": "node scripts/audit-rooms.mjs",
    "audit:architecture": "node scripts/architecture-plans.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "node scripts/browser-smoke.mjs && node scripts/browser-systems.mjs && node scripts/browser-phase10.mjs",
    "test:web:production": "node scripts/phase34-web-production-smoke.mjs && node scripts/browser-systems.mjs && node scripts/phase35-web-navigation.mjs && node scripts/phase35-webgl-production.mjs",
    "test:rescue:browser": "node scripts/browser-rescue.mjs",
    "test:reborn:hall": "node scripts/browser-reborn-hall.mjs",
    "test:reborn:survey": "node scripts/browser-reborn-survey.mjs",
    "test:ui": "node scripts/browser-remaster.mjs",
    "test:phase23:browser": "node scripts/browser-remaster.mjs --output-dir=docs/capturas/fase23",
    "test:mansion:stair:browser": "node scripts/browser-mansion-stair.mjs",
    "test:mansion:cinema:browser": "node scripts/browser-mansion-cinema.mjs",
    "test:phase26:widow:browser": "node scripts/browser-phase26-widow.mjs",
    "benchmark:phase26:widow": "node scripts/benchmark-phase26-widow.mjs",
    "test:phase21:browser": "bash scripts/phase21-1-qa.sh",
    "benchmark:phase9": "node scripts/performance-phase9.mjs",
    "benchmark:phase10": "node scripts/performance-phase10.mjs",
    "format:check": "prettier --check src tests scripts index.html package.json tsconfig.json vite.config.ts",
    "test:launcher": "node scripts/test-launcher.mjs",
    "test:phase1": "node scripts/browser-phase1.mjs && node scripts/browser-gamepad.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
